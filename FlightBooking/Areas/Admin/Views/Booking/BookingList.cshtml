@model ResultFlightDTO
@{
    ViewData["Title"] = "BookingList";
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
}

<main class="main-content" id="main-content">

    @* ── Page Header ─────────────────────────────────────────── *@
    <div class="page-header">
        <div class="page-title-group">
            <div class="page-breadcrumb">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
                <i class="bi bi-chevron-right sep"></i>
                <a asp-area="Admin" asp-controller="Flights" asp-action="Index"
                   style="color:var(--gray-500);text-decoration:none;">Flights Management</a>
                <i class="bi bi-chevron-right sep"></i>
                <span style="color:var(--accent);">Yeni Uçuş Ekle</span>
            </div>
            <h1 class="page-title">Yeni Uçuş Ekle</h1>
            <p class="page-desc">Sisteme yeni bir uçuş kaydı oluşturmak için formu eksiksiz doldurun.</p>
        </div>
    </div>

    @* ── Validation Summary ───────────────────────────────────── *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="val-card">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Formu göndermeden önce şu hataları düzeltin:</strong>
                <asp-validation-summary asp-validation-summary="All" />
            </div>
        </div>
    }

    @* ── FORM ─────────────────────────────────────────────────── *@
    <form method="post" id="flightForm" novalidate>
        @Html.AntiForgeryToken()

        <div class="create-grid">

            @* ════════════════════════════════════
               SOL KOLON — tüm form alanları
            ════════════════════════════════════ *@
            <div class="create-col-main">

                @* ── 1. Uçuş Kimliği ─────────────────── *@
                <div class="section-card">
                    <div class="section-header">
                        <div class="sh-icon blue"><i class="bi bi-airplane-fill"></i></div>
                        <div class="sh-text">
                            <div class="sh-title">Uçuş Kimliği</div>
                            <div class="sh-desc">Uçuş numarası, havayolu kodu ve durum bilgileri</div>
                        </div>
                    </div>
                    <div class="section-body">

                        <div class="fg-3 mb-18">

                            @* FlightNumber *@
                            <div class="field">
                                <label asp-for="FlightNumber" class="f-label">
                                    Uçuş Numarası <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-hash f-icon"></i>
                                    <input asp-for="FlightNumber"
                                           class="f-input"
                                           placeholder="TK102"
                                           maxlength="10"
                                           autocomplete="off"
                                           oninput="this.value=this.value.toUpperCase();syncPreview()" />
                                </div>
                                <span asp-validation-for="FlightNumber" class="f-error"></span>
                                <span class="f-hint">2 harf + rakam — örn. TK102</span>
                            </div>

                            @* AirlineCode *@
                            <div class="field">
                                <label asp-for="AirlineCode" class="f-label">
                                    Havayolu <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-building f-icon"></i>
                                    <select asp-for="AirlineCode" class="f-select" onchange="syncPreview()">
                                        <option value="">Seçin…</option>
                                        <option value="TK">TK – Turkish Airlines</option>
                                        <option value="PC">PC – Pegasus</option>
                                        <option value="XQ">XQ – SunExpress</option>
                                        <option value="LH">LH – Lufthansa</option>
                                        <option value="BA">BA – British Airways</option>
                                        <option value="AF">AF – Air France</option>
                                        <option value="KL">KL – KLM</option>
                                        <option value="EK">EK – Emirates</option>
                                    </select>
                                </div>
                                <span asp-validation-for="AirlineCode" class="f-error"></span>
                            </div>

                            @* Status *@
                            <div class="field">
                                <label asp-for="Status" class="f-label">
                                    Durum <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-circle-fill f-icon" id="statusDot" style="font-size:8px;color:var(--accent);"></i>
                                    <select asp-for="Status" class="f-select" id="statusSel" onchange="syncStatus()">
                                        <option value="">Seçin…</option>
                                        <option value="Scheduled">Scheduled – Planlandı</option>
                                        <option value="Boarding">Boarding – Biniş</option>
                                        <option value="Delayed">Delayed – Gecikmeli</option>
                                        <option value="Cancelled">Cancelled – İptal</option>
                                        <option value="Completed">Completed – Tamamlandı</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Status" class="f-error"></span>
                            </div>

                        </div>
                    </div>
                </div>

                @* ── 2. Kalkış Bilgileri ──────────────── *@
                <div class="section-card">
                    <div class="section-header">
                        <div class="sh-icon green"><i class="bi bi-box-arrow-up-right"></i></div>
                        <div class="sh-text">
                            <div class="sh-title">Kalkış Bilgileri</div>
                            <div class="sh-desc">Kalkış havalimanı kodu, adı ve tarih/saat</div>
                        </div>
                    </div>
                    <div class="section-body">

                        <div class="fg-2 mb-18">

                            @* DepartureAirportCode *@
                            <div class="field">
                                <label asp-for="DepartureAirportCode" class="f-label">
                                    Havalimanı Kodu <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-geo-alt-fill f-icon" style="color:#10B981;"></i>
                                    <input asp-for="DepartureAirportCode"
                                           class="f-input code"
                                           placeholder="IST"
                                           maxlength="3"
                                           oninput="this.value=this.value.toUpperCase();syncPreview()" />
                                </div>
                                <span asp-validation-for="DepartureAirportCode" class="f-error"></span>
                                <span class="f-hint">IATA kodu — 3 büyük harf</span>
                            </div>

                            @* DepartureAirportName *@
                            <div class="field">
                                <label asp-for="DepartureAirportName" class="f-label">
                                    Havalimanı Adı <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-building-fill f-icon"></i>
                                    <input asp-for="DepartureAirportName"
                                           class="f-input"
                                           placeholder="İstanbul Havalimanı"
                                           oninput="syncPreview()" />
                                </div>
                                <span asp-validation-for="DepartureAirportName" class="f-error"></span>
                            </div>

                        </div>

                        <div class="fg-1">
                            @* DepartureTime *@
                            <div class="field">
                                <label asp-for="DepartureTime" class="f-label">
                                    Kalkış Tarihi ve Saati <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-calendar3 f-icon"></i>
                                    <input asp-for="DepartureTime"
                                           type="datetime-local"
                                           class="f-input"
                                           onchange="calcDuration();syncPreview()" />
                                </div>
                                <span asp-validation-for="DepartureTime" class="f-error"></span>
                            </div>
                        </div>

                    </div>
                </div>

                @* ── 3. Varış Bilgileri ───────────────── *@
                <div class="section-card">
                    <div class="section-header">
                        <div class="sh-icon orange"><i class="bi bi-box-arrow-in-down-right"></i></div>
                        <div class="sh-text">
                            <div class="sh-title">Varış Bilgileri</div>
                            <div class="sh-desc">Varış havalimanı kodu, adı ve tarih/saat</div>
                        </div>
                    </div>
                    <div class="section-body">

                        <div class="fg-2 mb-18">

                            @* ArrivalAirportCode *@
                            <div class="field">
                                <label asp-for="ArrivalAirportCode" class="f-label">
                                    Havalimanı Kodu <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-geo-alt-fill f-icon" style="color:#F59E0B;"></i>
                                    <input asp-for="ArrivalAirportCode"
                                           class="f-input code"
                                           placeholder="LHR"
                                           maxlength="3"
                                           oninput="this.value=this.value.toUpperCase();syncPreview()" />
                                </div>
                                <span asp-validation-for="ArrivalAirportCode" class="f-error"></span>
                                <span class="f-hint">IATA kodu — 3 büyük harf</span>
                            </div>

                            @* ArrivalAirportName *@
                            <div class="field">
                                <label asp-for="ArrivalAirportName" class="f-label">
                                    Havalimanı Adı <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-building-fill f-icon"></i>
                                    <input asp-for="ArrivalAirportName"
                                           class="f-input"
                                           placeholder="London Heathrow"
                                           oninput="syncPreview()" />
                                </div>
                                <span asp-validation-for="ArrivalAirportName" class="f-error"></span>
                            </div>

                        </div>

                        <div class="fg-2">

                            @* ArrivalTime *@
                            <div class="field">
                                <label asp-for="ArrivalTime" class="f-label">
                                    Varış Tarihi ve Saati <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-calendar3 f-icon"></i>
                                    <input asp-for="ArrivalTime"
                                           type="datetime-local"
                                           class="f-input"
                                           onchange="calcDuration();syncPreview()" />
                                </div>
                                <span asp-validation-for="ArrivalTime" class="f-error"></span>
                            </div>

                            @* DurationMinutes *@
                            <div class="field">
                                <label asp-for="DurationMinutes" class="f-label">
                                    Uçuş Süresi (Dakika) <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-clock-fill f-icon"></i>
                                    <input asp-for="DurationMinutes"
                                           type="number"
                                           class="f-input has-suffix"
                                           placeholder="180"
                                           min="1" max="2880"
                                           id="durInput"
                                           oninput="syncDurSuffix()" />
                                    <span class="f-suffix" id="durSuffix">—</span>
                                </div>
                                <span asp-validation-for="DurationMinutes" class="f-error"></span>
                                <span class="f-hint">Tarihler girilince otomatik hesaplanır</span>
                            </div>

                        </div>

                    </div>
                </div>

                @* ── 4. Kapasite ──────────────────────── *@
                <div class="section-card">
                    <div class="section-header">
                        <div class="sh-icon purple"><i class="bi bi-people-fill"></i></div>
                        <div class="sh-text">
                            <div class="sh-title">Koltuk Kapasitesi</div>
                            <div class="sh-desc">Toplam ve müsait koltuk sayısı</div>
                        </div>
                    </div>
                    <div class="section-body">

                        <div class="fg-2 mb-18">

                            @* TotalSeats *@
                            <div class="field">
                                <label asp-for="TotalSeats" class="f-label">
                                    Toplam Koltuk <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-person-fill f-icon"></i>
                                    <input asp-for="TotalSeats"
                                           type="number"
                                           class="f-input"
                                           placeholder="180"
                                           min="1" max="900"
                                           oninput="syncCapacity()" />
                                </div>
                                <span asp-validation-for="TotalSeats" class="f-error"></span>
                            </div>

                            @* AvailableSeats *@
                            <div class="field">
                                <label asp-for="AvailableSeats" class="f-label">
                                    Müsait Koltuk <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-person-check-fill f-icon"></i>
                                    <input asp-for="AvailableSeats"
                                           type="number"
                                           class="f-input"
                                           placeholder="142"
                                           min="0"
                                           oninput="syncCapacity()" />
                                </div>
                                <span asp-validation-for="AvailableSeats" class="f-error"></span>
                            </div>

                        </div>

                        @* Doluluk barı *@
                        <div class="cap-widget">
                            <div class="cap-header">
                                <span class="cap-label">Doluluk Oranı</span>
                                <span class="cap-pct" id="capPct">—</span>
                            </div>
                            <div class="cap-track">
                                <div class="cap-fill" id="capFill"></div>
                            </div>
                            <div class="cap-footer">
                                <span id="capOcc">— dolu koltuk</span>
                                <span id="capFree">— müsait koltuk</span>
                            </div>
                        </div>

                    </div>
                </div>

                @* ── 5. Fiyatlandırma ─────────────────── *@
                <div class="section-card">
                    <div class="section-header">
                        <div class="sh-icon teal"><i class="bi bi-tag-fill"></i></div>
                        <div class="sh-text">
                            <div class="sh-title">Fiyatlandırma</div>
                            <div class="sh-desc">Baz fiyat ve para birimi</div>
                        </div>
                    </div>
                    <div class="section-body">

                        <div class="fg-2 mb-18">

                            @* BasePrice *@
                            <div class="field">
                                <label asp-for="BasePrice" class="f-label">
                                    Baz Fiyat <span class="f-req">*</span>
                                </label>
                                <div class="f-wrap">
                                    <i class="bi bi-currency-exchange f-icon"></i>
                                    <input asp-for="BasePrice"
                                           type="number"
                                           class="f-input has-suffix"
                                           placeholder="0.00"
                                           min="0" step="0.01"
                                           oninput="syncPrice()" />
                                    <span class="f-suffix" id="priceSuffix">—</span>
                                </div>
                                <span asp-validation-for="BasePrice" class="f-error"></span>
                            </div>

                            @* Currency *@
                            <div class="field">
                                <label class="f-label">Para Birimi <span class="f-req">*</span></label>
                                <div class="currency-row" id="currencyRow">

                                    <label class="cc-label" id="cc-TRY">
                                        <input type="radio" asp-for="Currency" value="TRY" onchange="pickCurrency(this,'₺')" />
                                        <span class="cc-sym">₺</span>
                                        <span class="cc-code">TRY</span>
                                    </label>

                                    <label class="cc-label" id="cc-EUR">
                                        <input type="radio" asp-for="Currency" value="EUR" onchange="pickCurrency(this,'€')" />
                                        <span class="cc-sym">€</span>
                                        <span class="cc-code">EUR</span>
                                    </label>

                                    <label class="cc-label" id="cc-USD">
                                        <input type="radio" asp-for="Currency" value="USD" onchange="pickCurrency(this,'$')" />
                                        <span class="cc-sym">$</span>
                                        <span class="cc-code">USD</span>
                                    </label>

                                    <label class="cc-label" id="cc-GBP">
                                        <input type="radio" asp-for="Currency" value="GBP" onchange="pickCurrency(this,'£')" />
                                        <span class="cc-sym">£</span>
                                        <span class="cc-code">GBP</span>
                                    </label>

                                </div>
                                <span asp-validation-for="Currency" class="f-error"></span>
                            </div>

                        </div>

                    </div>

                    @* Form Aksiyonları *@
                    <div class="form-actions">
                        <a asp-area="Admin" asp-controller="Flights" asp-action="Index"
                           class="btn-cancel-form">
                            <i class="bi bi-arrow-left"></i> Listeye Dön
                        </a>
                        <button type="submit" class="btn-save-form" id="saveBtn">
                            <span id="saveBtnIdle"><i class="bi bi-check-circle-fill"></i> Uçuşu Kaydet</span>
                            <span id="saveBtnLoad" style="display:none;"><span class="spinner"></span> Kaydediliyor…</span>
                        </button>
                    </div>

                </div>

            </div>

            @* ════════════════════════════════════
               SAĞ KOLON — canlı önizleme
            ════════════════════════════════════ *@
            <div class="create-col-side">

                @* Uçuş Kartı Önizlemesi *@
                <div class="route-card">
                    <div class="rc-label">CANLI ÖNİZLEME</div>

                    <div class="rc-flight-no" id="rc-no">——</div>
                    <div class="rc-airline" id="rc-airline">Havayolu seçin</div>

                    <div class="rc-route">
                        <div class="rc-airport">
                            <span class="rc-code" id="rc-dep-code">IST</span>
                            <span class="rc-city" id="rc-dep-name">Kalkış</span>
                        </div>
                        <div class="rc-arrow">
                            <div class="rc-line">
                                <i class="bi bi-airplane-fill rc-plane-icon"></i>
                            </div>
                            <span class="rc-dur" id="rc-dur">— dk</span>
                        </div>
                        <div class="rc-airport">
                            <span class="rc-code" id="rc-arr-code">—</span>
                            <span class="rc-city" id="rc-arr-name">Varış</span>
                        </div>
                    </div>

                    <div class="rc-divider"></div>

                    <div class="rc-meta">
                        <div class="rc-meta-item">
                            <span class="rc-meta-key">Kalkış</span>
                            <span class="rc-meta-val" id="rc-dep-time">—</span>
                        </div>
                        <div class="rc-meta-item">
                            <span class="rc-meta-key">Varış</span>
                            <span class="rc-meta-val" id="rc-arr-time">—</span>
                        </div>
                        <div class="rc-meta-item">
                            <span class="rc-meta-key">Kapasite</span>
                            <span class="rc-meta-val" id="rc-cap">—</span>
                        </div>
                        <div class="rc-meta-item">
                            <span class="rc-meta-key">Fiyat</span>
                            <span class="rc-meta-val" id="rc-price">—</span>
                        </div>
                    </div>

                    <div class="rc-status" id="rc-status">
                        <span class="dot"></span>
                        <span id="rc-status-txt">Durum seçin</span>
                    </div>
                </div>

                @* Zorunlu alan notu *@
                <div style="background:var(--white);border:1px solid var(--gray-100);border-radius:var(--radius);padding:16px 18px;box-shadow:var(--shadow-sm);">
                    <div style="font-size:12px;font-weight:700;color:var(--navy);margin-bottom:10px;">
                        <i class="bi bi-info-circle-fill" style="color:var(--accent);margin-right:6px;"></i>Bilgi
                    </div>
                    <ul style="font-size:12px;color:var(--gray-500);padding-left:16px;line-height:1.8;margin:0;">
                        <li><span style="color:#EF4444;">*</span> ile işaretli alanlar zorunludur.</li>
                        <li>Uçuş süresi kalkış ve varış saatinden otomatik hesaplanır.</li>
                        <li>IATA kodları 3 büyük harf olmalıdır (IST, LHR, CDG…).</li>
                        <li>Baz fiyat vergisiz bilet ücretidir.</li>
                    </ul>
                </div>

            </div>

        </div>
    </form>


﻿<div class="container-fluid mt-4 px-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size:13px;">
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Dashboard</a></li>
                    <li class="breadcrumb-item active">Rezervasyon Listesi</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0" style="color:#0f172a;">Rezervasyon Listesi</h4>
            <p class="text-muted mb-0" style="font-size:13px;">Sistemdeki tüm rezervasyonları görüntüleyin ve yönetin.</p>
        </div>
        <a href="#" class="btn btn-primary px-4" style="border-radius:9px;font-weight:600;font-size:13.5px;">
            <i class="bi bi-plus-lg me-2"></i>Yeni Rezervasyon
        </a>
    </div>

    <!-- Filtre Alanı -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
        <div class="card-body px-4 py-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold mb-1" style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;">Uçuş No</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0" style="border-radius:8px 0 0 8px;border-color:#e5e7eb;">
                            <i class="bi bi-search text-muted" style="font-size:12px;"></i>
                        </span>
                        <input type="text" id="filterFlight" class="form-control border-start-0"
                               placeholder="TK102..." onkeyup="applyFilter()"
                               style="border-radius:0 8px 8px 0;border-color:#e5e7eb;font-size:13px;" />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold mb-1" style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;">Durum</label>
                    <select id="filterStatus" class="form-select form-select-sm" onchange="applyFilter()"
                            style="border-radius:8px;border-color:#e5e7eb;font-size:13px;">
                        <option value="">Tümü</option>
                        <option value="Confirmed">Onaylandı</option>
                        <option value="Pending">Beklemede</option>
                        <option value="Cancelled">İptal</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label fw-semibold mb-1" style="font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:.4px;">Rezervasyon Tarihi</label>
                    <input type="date" id="filterDate" class="form-control form-control-sm" onchange="applyFilter()"
                           style="border-radius:8px;border-color:#e5e7eb;font-size:13px;" />
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button class="btn btn-primary btn-sm flex-fill" onclick="applyFilter()" style="border-radius:8px;font-weight:600;">
                        <i class="bi bi-funnel-fill me-1"></i> Filtrele
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="clearFilter()" style="border-radius:8px;" title="Temizle">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card border-0 shadow-sm" style="border-radius:14px;overflow:hidden;">
        <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
            <span class="fw-semibold" style="font-size:13.5px;color:#0f172a;">
                Tüm Rezervasyonlar
            </span>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3" id="totalCount" style="font-size:12px;">20 kayıt</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="bookingTable">
                <thead style="background:#f8fafc;">
                    <tr>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">#</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">Uçuş No</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">İletişim Adı</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">Yolcu Sayısı</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">Toplam Fiyat</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">Rezervasyon Tarihi</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">Durum</th>
                        <th style="font-size:11px;font-weight:700;letter-spacing:.7px;color:#94a3b8;text-transform:uppercase;padding:12px 16px;border-bottom:1px solid #f1f5f9;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="tableBody" style="font-size:13.5px;">
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="card-footer bg-white border-top px-4 py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="text-muted" style="font-size:12.5px;" id="pageInfo"></span>
            <nav>
                <ul class="pagination pagination-sm mb-0 gap-1" id="pagination"></ul>
            </nav>
        </div>
    </div>

</div>

<script>
    var allData = [
        { id:'RES-001', flight:'TK1932', name:'Ahmet Yılmaz',      passengers:2, price:'492 EUR', date:'2025-04-06', status:'Confirmed'  },
        { id:'RES-002', flight:'PC2014', name:'Ayşe Kara',         passengers:1, price:'146 EUR', date:'2025-04-06', status:'Pending'    },
        { id:'RES-003', flight:'TK1021', name:'Mehmet Demir',      passengers:3, price:'633 EUR', date:'2025-04-07', status:'Confirmed'  },
        { id:'RES-004', flight:'LH1305', name:'Fatma Çelik',       passengers:1, price:'260 EUR', date:'2025-04-07', status:'Cancelled'  },
        { id:'RES-005', flight:'TK1850', name:'Ali Öztürk',        passengers:4, price:'1100 EUR',date:'2025-04-08', status:'Confirmed'  },
        { id:'RES-006', flight:'PC3022', name:'Zeynep Arslan',     passengers:2, price:'640 EUR', date:'2025-04-08', status:'Pending'    },
        { id:'RES-007', flight:'TK9001', name:'Hasan Şahin',       passengers:1, price:'780 EUR', date:'2025-04-09', status:'Confirmed'  },
        { id:'RES-008', flight:'TK1932', name:'Elif Yıldız',       passengers:2, price:'492 EUR', date:'2025-04-09', status:'Cancelled'  },
        { id:'RES-009', flight:'LH1305', name:'Mustafa Aydın',     passengers:3, price:'780 EUR', date:'2025-04-10', status:'Confirmed'  },
        { id:'RES-010', flight:'PC2014', name:'Selin Güneş',       passengers:1, price:'146 EUR', date:'2025-04-10', status:'Pending'    },
        { id:'RES-011', flight:'TK1021', name:'Burak Koç',         passengers:2, price:'422 EUR', date:'2025-04-11', status:'Confirmed'  },
        { id:'RES-012', flight:'TK9001', name:'Deniz Polat',       passengers:1, price:'780 EUR', date:'2025-04-11', status:'Cancelled'  },
        { id:'RES-013', flight:'PC3022', name:'Gizem Erdoğan',     passengers:4, price:'1280 EUR',date:'2025-04-12', status:'Confirmed'  },
        { id:'RES-014', flight:'TK1850', name:'Serkan Doğan',      passengers:2, price:'550 EUR', date:'2025-04-12', status:'Pending'    },
        { id:'RES-015', flight:'LH1305', name:'Merve Aksoy',       passengers:1, price:'260 EUR', date:'2025-04-13', status:'Confirmed'  },
        { id:'RES-016', flight:'TK1932', name:'Cem Kılıç',         passengers:3, price:'738 EUR', date:'2025-04-13', status:'Confirmed'  },
        { id:'RES-017', flight:'PC2014', name:'Neslihan Bozkurt',  passengers:1, price:'146 EUR', date:'2025-04-14', status:'Cancelled'  },
        { id:'RES-018', flight:'TK1021', name:'Oğuz Tekin',        passengers:2, price:'422 EUR', date:'2025-04-14', status:'Pending'    },
        { id:'RES-019', flight:'TK9001', name:'Pınar Çakır',       passengers:1, price:'780 EUR', date:'2025-04-15', status:'Confirmed'  },
        { id:'RES-020', flight:'LH1305', name:'Emre Yavuz',        passengers:3, price:'780 EUR', date:'2025-04-15', status:'Confirmed'  },
    ];

    var filtered    = allData.slice();
    var currentPage = 1;
    var perPage     = 8;

    var statusCfg = {
        'Confirmed': { label: 'Onaylandı', cls: 'bg-success-subtle text-success',  icon: 'bi-check-circle-fill' },
        'Pending'  : { label: 'Beklemede', cls: 'bg-warning-subtle text-warning',  icon: 'bi-clock-fill'        },
        'Cancelled': { label: 'İptal',     cls: 'bg-danger-subtle text-danger',    icon: 'bi-x-circle-fill'     },
    };

    function applyFilter() {
        var flightQ = (document.getElementById('filterFlight').value  || '').toLowerCase().trim();
        var statusQ =  document.getElementById('filterStatus').value;
        var dateQ   =  document.getElementById('filterDate').value;

        filtered = allData.filter(function (r) {
            var mF = !flightQ || r.flight.toLowerCase().includes(flightQ) || r.id.toLowerCase().includes(flightQ);
            var mS = !statusQ || r.status === statusQ;
            var mD = !dateQ   || r.date === dateQ;
            return mF && mS && mD;
        });

        currentPage = 1;
        render();
    }

    function clearFilter() {
        document.getElementById('filterFlight').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterDate').value   = '';
        filtered = allData.slice();
        currentPage = 1;
        render();
    }

    function render() {
        var total      = filtered.length;
        var totalPages = Math.max(1, Math.ceil(total / perPage));
        if (currentPage > totalPages) currentPage = totalPages;

        var from  = total === 0 ? 0 : (currentPage - 1) * perPage + 1;
        var to    = Math.min(currentPage * perPage, total);
        var slice = filtered.slice(from - 1, to);

        document.getElementById('totalCount').textContent = total + ' kayıt';
        document.getElementById('pageInfo').textContent   = total === 0
            ? 'Sonuç bulunamadı'
            : from + '–' + to + ' / ' + total + ' kayıt gösteriliyor';

        var tbody = document.getElementById('tableBody');

        if (slice.length === 0) {
            tbody.innerHTML =
                '<tr><td colspan="8" class="text-center py-5 text-muted">' +
                    '<i class="bi bi-inbox" style="font-size:32px;display:block;margin-bottom:10px;opacity:.25;"></i>' +
                    'Kayıt bulunamadı.' +
                '</td></tr>';
            document.getElementById('pagination').innerHTML = '';
            return;
        }

        tbody.innerHTML = slice.map(function (r, i) {
            var cfg    = statusCfg[r.status] || { label: r.status, cls: 'bg-secondary-subtle text-secondary', icon: 'bi-circle' };
            var rowNum = (currentPage - 1) * perPage + i + 1;

            return '<tr style="border-bottom:1px solid #f1f5f9;">' +
                '<td style="padding:13px 16px;color:#94a3b8;font-size:12px;font-weight:600;">' + rowNum + '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<span style="font-family:monospace;font-weight:700;font-size:13.5px;color:#0f172a;">' + r.flight + '</span>' +
                    '<div style="font-size:11px;color:#94a3b8;margin-top:1px;">' + r.id + '</div>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<div class="d-flex align-items-center gap-2">' +
                        '<div style="width:30px;height:30px;border-radius:8px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#475569;flex-shrink:0;">' +
                            r.name.split(' ').map(function(w){ return w[0]; }).join('').slice(0,2).toUpperCase() +
                        '</div>' +
                        '<span style="font-weight:500;color:#1e293b;">' + r.name + '</span>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<div class="d-flex align-items-center gap-1">' +
                        '<i class="bi bi-people-fill text-muted" style="font-size:12px;"></i>' +
                        '<span style="font-weight:600;color:#0f172a;">' + r.passengers + '</span>' +
                        '<span style="font-size:12px;color:#94a3b8;"> yolcu</span>' +
                    '</div>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<span style="font-weight:700;color:#0f172a;font-size:14px;">' + r.price + '</span>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<span style="color:#374151;font-size:13px;">' + formatDate(r.date) + '</span>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<span class="badge ' + cfg.cls + ' d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill" style="font-size:11.5px;font-weight:600;">' +
                        '<i class="bi ' + cfg.icon + '" style="font-size:9px;"></i>' + cfg.label +
                    '</span>' +
                '</td>' +
                '<td style="padding:13px 16px;">' +
                    '<div class="d-flex gap-1">' +
                        '<a href="#" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1" style="border-radius:7px;font-size:12px;padding:4px 10px;">' +
                            '<i class="bi bi-eye-fill" style="font-size:11px;"></i> Detay' +
                        '</a>' +
                        '<button class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-1" style="border-radius:7px;font-size:12px;padding:4px 10px;" onclick="cancelBooking(\'' + r.id + '\')">' +
                            '<i class="bi bi-x-circle-fill" style="font-size:11px;"></i> İptal' +
                        '</button>' +
                    '</div>' +
                '</td>' +
            '</tr>';
        }).join('');

        renderPagination(totalPages);
    }

    function renderPagination(totalPages) {
        var ul   = document.getElementById('pagination');
        var html = '';

        html += '<li class="page-item' + (currentPage === 1 ? ' disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goPage(currentPage-1);return false;" style="border-radius:8px;font-size:12.5px;">' +
                '<i class="bi bi-chevron-left" style="font-size:10px;"></i>' +
            '</a></li>';

        var pages = buildRange(currentPage, totalPages);
        pages.forEach(function (p) {
            if (p === '...') {
                html += '<li class="page-item disabled"><span class="page-link" style="border:none;background:none;color:#94a3b8;">…</span></li>';
            } else {
                html += '<li class="page-item' + (p === currentPage ? ' active' : '') + '">' +
                    '<a class="page-link" href="#" onclick="goPage(' + p + ');return false;" style="border-radius:8px;font-size:12.5px;font-weight:' + (p === currentPage ? '700' : '500') + ';">' + p + '</a>' +
                '</li>';
            }
        });

        html += '<li class="page-item' + (currentPage === totalPages ? ' disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goPage(currentPage+1);return false;" style="border-radius:8px;font-size:12.5px;">' +
                '<i class="bi bi-chevron-right" style="font-size:10px;"></i>' +
            '</a></li>';

        ul.innerHTML = html;
    }

    function buildRange(cur, total) {
        if (total <= 7) {
            var a = [];
            for (var i = 1; i <= total; i++) a.push(i);
            return a;
        }
        var p = [1];
        if (cur > 3) p.push('...');
        for (var x = Math.max(2, cur-1); x <= Math.min(total-1, cur+1); x++) p.push(x);
        if (cur < total - 2) p.push('...');
        p.push(total);
        return p;
    }

    function goPage(p) {
        var totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
        if (p < 1 || p > totalPages) return;
        currentPage = p;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function formatDate(d) {
        var months = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];
        var parts = d.split('-');
        return parts[2] + ' ' + months[parseInt(parts[1])-1] + ' ' + parts[0];
    }

    function cancelBooking(id) {
        if (!confirm(id + ' numaralı rezervasyonu iptal etmek istediğinize emin misiniz?')) return;
        var row = allData.find(function(r){ return r.id === id; });
        if (row) { row.status = 'Cancelled'; applyFilter(); }
    }

    document.addEventListener('DOMContentLoaded', function () { render(); });
</script>

</main>